---
import { getCollection } from 'astro:content';
import { getExplainers } from '../lib/explainers';

// 仮トップ：全ノートをトップフォルダごとに折りたたんで表示＋解説HTMLの一覧（Step 3 で本実装に置き換える）
const notes = (await getCollection('notes')).sort((a, b) =>
  a.id.localeCompare(b.id, 'ja', { numeric: true }),
);

const groups = new Map<string, typeof notes>();
for (const entry of notes) {
  const top = entry.id.includes('/') ? entry.id.split('/')[0] : '（ルート）';
  groups.set(top, [...(groups.get(top) ?? []), entry]);
}

// ファイル名の ? # % が URL の区切りとして解釈されないよう、各パス要素をエンコードする（Step 2 で idToUrl に置き換える）
const noteUrl = (id: string) => `/notes/${id.split('/').map(encodeURIComponent).join('/')}`;

const explainers = getExplainers();
const explainerCount = explainers.reduce((n, f) => n + f.pages.length, 0);
---
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Knowledge</title>
  </head>
  <body>
    <h1>Knowledge</h1>
    <p><a href="/history/">Git 履歴（ローカル専用）</a></p>

    <h2>解説ページ（{explainerCount} 件）</h2>
    {explainers.map((f) => (
      <details>
        <summary>{f.folder}（{f.pages.length}）</summary>
        <ul>
          {f.pages.map((p) => <li><a href={p.url}>{p.name}</a></li>)}
        </ul>
      </details>
    ))}

    <h2>ノート（{notes.length} 件）</h2>
    {[...groups].map(([top, entries]) => (
      <details>
        <summary>{top}（{entries.length}）</summary>
        <ul>
          {entries.map((entry) => (
            <li><a href={noteUrl(entry.id)}>{entry.id.slice(top.length + 1) || entry.id}</a></li>
          ))}
        </ul>
      </details>
    ))}
  </body>
</html>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getExplainers } from '../lib/explainers';
import { countFolders, getNoteIndex } from '../lib/notes';

const index = getNoteIndex();
const explainers = getExplainers();
const explainerCount = explainers.reduce((n, f) => n + f.pages.length, 0);

// 分類は番号の十の位で決める（詳細設計 §5.1）
const CATEGORIES = ['', '基礎', '言語', 'フレームワーク', '設計', 'ツール', 'インフラ', 'セキュリティ', 'テスト', 'その他'];
const rows = index.root.folders.map((f) => {
  const num = f.name.match(/^(\d+)[_\-]/)?.[1] ?? '';
  const tens = num.length >= 2 ? Number(num[0]) : NaN;
  return { folder: f, num, category: CATEGORIES[tens] ?? '—' };
});

const fmt = (n: number) => n.toLocaleString('en-US');
---
<BaseLayout
  title="トップ"
  status={[`${fmt(index.byId.size)} notes`, `${fmt(countFolders(index.root))} folders`, `${fmt(explainerCount)} explainers`]}
>
  <h1>Knowledge</h1>

  <section>
    <h2>ようこそ</h2>
    <p class="lead">
      プログラミング学習ノートの置き場です。左のエクスプローラーか下のフォルダ表からノートをたどれます。
      図解つきで学びたいときは「解説ページ」から読み始めてください。
    </p>
    <p><a href="/history/">Git 履歴（ローカル専用）</a></p>
  </section>

  <section>
    <h2>解説ページ（HTML）</h2>
    <ul class="cards">
      {explainers.map((f) => {
        const toc = f.pages.find((p) => p.name === '00-0_目次') ?? f.pages[0];
        const [, num, label] = f.folder.match(/^(\d+)[_\-](.+)$/) ?? [, '', f.folder];
        return (
          <li>
            <a class="card" href={toc.url}>
              {num && <span class="card-num">{num}</span>}
              <span class="card-label">{label}</span>
              <span class="count">{f.pages.length} ページ</span>
            </a>
          </li>
        );
      })}
    </ul>
  </section>

  <section>
    <h2>すべてのフォルダ</h2>
    <table>
        <thead>
          <tr><th>No</th><th>分類</th><th>フォルダ</th><th>ノート数</th></tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <td class="num">{r.num}</td>
              <td>{r.category}</td>
              <td><a href={r.folder.url}>{r.folder.label}</a></td>
              <td class="num">{fmt(r.folder.noteCount)}</td>
            </tr>
          ))}
        </tbody>
    </table>
  </section>
</BaseLayout>

<style>
  .lead {
    color: var(--text-2);
  }
  .cards {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 8px;
  }
  .cards li + li {
    margin-top: 0;
  }
  .card {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding: 12px 14px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
  }
  .card:hover {
    border-color: var(--accent);
    color: var(--text);
  }
  .card-num {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-3);
  }
  .card-label {
    flex: 1;
    min-width: 0;
    font-weight: 500;
  }
  .card .count {
    font-size: 11px;
  }
  table {
    white-space: nowrap;
  }
  .num {
    font-family: var(--mono);
    text-align: right;
    color: var(--text-3);
  }
</style>

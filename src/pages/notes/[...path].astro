---
import { getCollection, render } from 'astro:content';
import { getNoteIndex, urlPathOf } from '../../lib/note-index';

// Step 2：idToUrl で ? # % 空白を変換したパスを使う
export async function getStaticPaths() {
  const notes = await getCollection('notes');
  const index = getNoteIndex();
  return notes.map((entry) => {
    const ref = index.byId.get(entry.id);
    const path = ref ? urlPathOf(ref.url) : entry.id;
    return {
      params: { path },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const title = entry.data.title ?? headings.find((h) => h.depth === 1)?.text ?? entry.id.split('/').pop();
---
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}｜Knowledge</title>
  </head>
  <body>
    <p><a href="/">← トップ</a> ／ {entry.id}</p>
    <Content />
  </body>
</html>
